{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@tradeup/shared": ["./packages/shared/src/index.ts"],
      "@tradeup/db": ["./packages/db/src/index.ts"],
      "@tradeup/ui": ["./packages/ui/src/index.ts"]
    }
  }
}
